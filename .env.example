# Token từ @BotFather
BOT_TOKEN=123456:ABC...

# Lấy bằng lệnh /id trong group (số âm, dạng -100...). Để trống lúc setup lần đầu.
CHAT_ID=

# user_id Telegram của bạn (lấy bằng /id). Nhiều người: phẩy ngăn cách.
ALLOWED_USER_IDS=

# Nơi chứa các project, mỗi topic một thư mục
PROJECTS_ROOT=~/agents

# Thư mục mẫu copy vào mỗi project mới (CLAUDE.md, .claude/settings.json)
TEMPLATE_DIR=./template

# Đường dẫn claude CLI (chạy `which claude` để lấy)
CLAUDE_BIN=claude

# Để trống = model mặc định. Ví dụ: sonnet, opus
CLAUDE_MODEL=

# auto (khuyên dùng): tự sửa file và chạy lệnh, có bộ lọc chặn lệnh nguy hiểm.
# acceptEdits: chỉ chạy lệnh trong allow-list (lệnh khác bị từ chối vì không có ai bấm duyệt).
# Đổi riêng từng topic bằng /mode.
PERMISSION_MODE=auto

# Số session chạy cùng lúc (giữ thấp để không cháy quota)
MAX_CONCURRENT=2

# Plugin tắt riêng cho bot (Claude CLI trên máy vẫn dùng bình thường). Phẩy ngăn cách.
# Vd superpowers bắt gọi skill trước mọi câu trả lời → chậm khi chat qua Telegram.
DISABLED_PLUGINS=superpowers@superpowers-marketplace
