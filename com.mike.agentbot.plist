<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mike.agentbot</string>

  <!-- Sửa đường dẫn thư mục cho đúng. Dùng login shell để PATH có node + claude. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/tele-agent-router" &amp;&amp; exec node --env-file=.env index.mjs</string>
  </array>

  <!-- launchd không nạp ~/.zshrc nên phải khai báo PATH (nvm node + claude) -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/mike/.local/bin:/Users/mike/.nvm/versions/node/v24.18.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/agentbot.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agentbot.err.log</string>
</dict>
</plist>
